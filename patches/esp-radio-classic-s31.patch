diff --git a/esp-radio/src/ble/btdm2/classic.rs b/esp-radio/src/ble/btdm2/classic.rs
new file mode 100644
index 000000000..41a165c5d
--- /dev/null
+++ b/esp-radio/src/ble/btdm2/classic.rs
@@ -0,0 +1,235 @@
+//! Experimental S31 BR/EDR controller bring-up for inquiry only.
+//! ABI mirrored from Espressif porting_btdm/bredr.c. RustCrypto generates
+//! controller initialization keys. ECDH/pairing remains unsupported.
+use super::*;
+use hmac::{Hmac, Mac};
+use sha2::{Digest, Sha256};
+
+unsafe extern "C" {
+    fn bredr_controller_init(cfg: *mut esp_bredr_controller_config_t) -> i32;
+    fn bredr_controller_deinit();
+    fn bredr_register_setup_callback(cb: unsafe extern "C" fn() -> i32);
+    fn bredr_register_ext_dep_callback(cb: unsafe extern "C" fn() -> i32);
+    fn bredr_register_crypto_funcs(table: *const CryptoOps) -> i32;
+    fn bredr_register_bb_funcs(table: *const BbOps) -> i32;
+    fn bredr_hci_trans_register_tx(
+        acl: unsafe extern "C" fn(*mut HciDriverPacket) -> i32,
+        sync: unsafe extern "C" fn(*mut HciDriverPacket) -> i32,
+        event: unsafe extern "C" fn(*mut HciDriverPacket) -> i32,
+    );
+    fn bredr_hci_trans_evt_tx_done(pkt: *mut HciDriverPacket);
+    fn bredr_hci_trans_evt_free(pkt: *mut HciDriverPacket) -> i32;
+    fn bredr_tx_cca_fifo_empty() -> bool;
+    fn bredr_tx_cca_fifo_full() -> bool;
+    fn bredr_tx_cca_fifo_count() -> u32;
+    fn bredr_tx_cca_fifo_read() -> u32;
+    fn bredr_tx_cca_period(ru: u32, cca: u32);
+    fn bredr_tx_cca_set(
+        en: u32,
+        lo: u32,
+        drop0: u32,
+        high0: u32,
+        low0: u32,
+        enhi: u32,
+        hi: u32,
+        drop1: u32,
+        high1: u32,
+        low1: u32,
+    );
+    fn bredr_tx_cca_fifo_reset();
+    fn bredr_set_tx_on_delay(delay: u32);
+}
+
+#[repr(C)]
+struct CryptoOps {
+    p256_pair: unsafe extern "C" fn(*mut u8, *mut u8) -> i32,
+    p256_dh: unsafe extern "C" fn(*const u8, *const u8, *const u8, *mut u8) -> i32,
+    p192_pair: unsafe extern "C" fn(*mut u8, *mut u8) -> i32,
+    p192_dh: unsafe extern "C" fn(*const u8, *const u8, *const u8, *mut u8) -> i32,
+    sha: unsafe extern "C" fn(*const u8, u32, *mut u8) -> i32,
+    hmac: unsafe extern "C" fn(*const u8, u32, *const u8, u32, *mut u8) -> i32,
+}
+// RF entropy is enabled when these controller initialization callbacks run.
+#[path = "classic_crypto.rs"]
+mod crypto;
+unsafe extern "C" fn pair192(public: *mut u8, private: *mut u8) -> i32 {
+    if public.is_null() || private.is_null() {
+        return -1;
+    }
+    let public = unsafe { &mut *public.cast::<[u8; 48]>() };
+    let private = unsafe { &mut *private.cast::<[u8; 24]>() };
+    if crypto::generate192(public, private, || unsafe {
+        crate::common_adapter::random()
+    }) {
+        0
+    } else {
+        -1
+    }
+}
+unsafe extern "C" fn pair256(public: *mut u8, private: *mut u8) -> i32 {
+    if public.is_null() || private.is_null() {
+        return -1;
+    }
+    let public = unsafe { &mut *public.cast::<[u8; 64]>() };
+    let private = unsafe { &mut *private.cast::<[u8; 32]>() };
+    if crypto::generate256(public, private, || unsafe {
+        crate::common_adapter::random()
+    }) {
+        0
+    } else {
+        -1
+    }
+}
+unsafe extern "C" fn reject_dh(_: *const u8, _: *const u8, _: *const u8, _: *mut u8) -> i32 {
+    -1
+}
+unsafe extern "C" fn sha(msg: *const u8, len: u32, out: *mut u8) -> i32 {
+    if msg.is_null() || out.is_null() {
+        return -1;
+    }
+    let digest = Sha256::digest(unsafe { core::slice::from_raw_parts(msg, len as usize) });
+    unsafe { core::ptr::copy_nonoverlapping(digest.as_ptr(), out, 32) };
+    0
+}
+unsafe extern "C" fn hmac(
+    key: *const u8,
+    key_len: u32,
+    msg: *const u8,
+    len: u32,
+    out: *mut u8,
+) -> i32 {
+    if key.is_null() || msg.is_null() || out.is_null() {
+        return -1;
+    }
+    let Ok(mut mac) = <Hmac<Sha256> as Mac>::new_from_slice(unsafe {
+        core::slice::from_raw_parts(key, key_len as usize)
+    }) else {
+        return -1;
+    };
+    mac.update(unsafe { core::slice::from_raw_parts(msg, len as usize) });
+    let digest = mac.finalize().into_bytes();
+    unsafe { core::ptr::copy_nonoverlapping(digest.as_ptr(), out, 32) };
+    0
+}
+static CRYPTO: CryptoOps = CryptoOps {
+    p256_pair: pair256,
+    p256_dh: reject_dh,
+    p192_pair: pair192,
+    p192_dh: reject_dh,
+    sha,
+    hmac,
+};
+#[repr(C)]
+struct CcaParams {
+    en: u32,
+    lo: u32,
+    drop0: u32,
+    high0: u32,
+    low0: u32,
+    enhi: u32,
+    hi: u32,
+    drop1: u32,
+    high1: u32,
+    low1: u32,
+}
+#[repr(C)]
+struct BbOps {
+    empty: unsafe extern "C" fn() -> bool,
+    full: unsafe extern "C" fn() -> bool,
+    count: unsafe extern "C" fn() -> u32,
+    read: unsafe extern "C" fn() -> u32,
+    period: unsafe extern "C" fn(u32, u32),
+    set: unsafe extern "C" fn(*const CcaParams),
+    reset: unsafe extern "C" fn(),
+    delay: unsafe extern "C" fn(u32),
+}
+unsafe extern "C" fn set_cca(ptr: *const CcaParams) {
+    if let Some(p) = unsafe { ptr.as_ref() } {
+        unsafe {
+            bredr_tx_cca_set(
+                p.en, p.lo, p.drop0, p.high0, p.low0, p.enhi, p.hi, p.drop1, p.high1, p.low1,
+            )
+        }
+    }
+}
+static BB: BbOps = BbOps {
+    empty: bredr_tx_cca_fifo_empty,
+    full: bredr_tx_cca_fifo_full,
+    count: bredr_tx_cca_fifo_count,
+    read: bredr_tx_cca_fifo_read,
+    period: bredr_tx_cca_period,
+    set: set_cca,
+    reset: bredr_tx_cca_fifo_reset,
+    delay: bredr_set_tx_on_delay,
+};
+unsafe extern "C" fn setup() -> i32 {
+    0
+} // no SCO/APB/CPB/test/coexistence profiles
+unsafe extern "C" fn dependencies() -> i32 {
+    let res = unsafe { bredr_register_crypto_funcs(&CRYPTO) };
+    if res != 0 {
+        return res;
+    }
+    unsafe { bredr_register_bb_funcs(&BB) }
+}
+#[path = "classic_pool.rs"]
+mod pool;
+use pool::{pool_create, pool_free, pool_malloc};
+static POOL: orca_mempool_ops = orca_mempool_ops {
+    create_with_pool: Some(pool_create),
+    destroy: None,
+    malloc: Some(pool_malloc),
+    free: Some(pool_free),
+};
+
+pub(super) fn config() -> esp_bredr_controller_config_t {
+    let mut cfg: esp_bredr_controller_config_t = unsafe { core::mem::zeroed() };
+    // Matches the shipped 0.3.0 archive and its pre-b9ba3ea3ad8 IDF
+    // configuration layout (no additional synchronous-buffer fields).
+    cfg.bredr_version = 0x20250327;
+    cfg.bredr_magic = 0x5a5aa5a5;
+    cfg.max_acl_conn = 1;
+    cfg.max_sync_conn = 0;
+    cfg.cca_rssi_thr = -50;
+    cfg.static_aclu_tx_buf_nb = 2;
+    cfg.dynamic_aclu_tx_buf_nb = 0;
+    cfg.aclu_rx_buf_nb = 2;
+    cfg.mempool_size = 3 * 1024;
+    cfg.mempool_ops = &raw const POOL as *mut _;
+    // Zero dBm for every discovery/page/ACL transmit path; no SCO support.
+    cfg
+}
+pub(super) fn init(cfg: *mut esp_bt_controller_config_t) -> i32 {
+    unsafe {
+        // Published esp-wifi-sys S31 0.3.0 uses this ABI and does not export
+        // the later IDF bredr_ctrl_get_btdm_info query. Keep all archives from
+        // that pinned package; do not mix in a newer controller/common library.
+        bredr_register_setup_callback(setup);
+        bredr_register_ext_dep_callback(dependencies);
+        let result = bredr_controller_init(&raw mut (*cfg).bredr);
+        if result == 0 {
+            bredr_hci_trans_register_tx(reject_data, reject_data, host_rx);
+        }
+        result
+    }
+}
+unsafe extern "C" fn host_rx(pkt: *mut HciDriverPacket) -> i32 {
+    let Some(p) = (unsafe { pkt.as_ref() }) else {
+        return -1;
+    };
+    queue_rx_packet(&[p.type_], unsafe {
+        core::slice::from_raw_parts(p.data, p.length as usize)
+    });
+    unsafe {
+        bredr_hci_trans_evt_tx_done(pkt);
+        bredr_hci_trans_evt_free(pkt)
+    };
+    0
+}
+pub(super) fn deinit() {
+    unsafe { bredr_controller_deinit() }
+}
+
+unsafe extern "C" fn reject_data(_: *mut HciDriverPacket) -> i32 {
+    -1
+}
diff --git a/esp-radio/src/ble/btdm2/classic_crypto.rs b/esp-radio/src/ble/btdm2/classic_crypto.rs
