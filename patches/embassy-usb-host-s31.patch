+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core::pin::Pin;
+    use core::task::{Context, Waker};
+    use embassy_usb_driver::{Direction, EndpointAddress};
+    use std::{boxed::Box, thread, time::Duration as StdDuration};
+
+    fn poll_once<F: core::future::Future>(f: Pin<&mut F>) -> Poll<F::Output> {
+        f.poll(&mut Context::from_waker(Waker::noop()))
+    }
+    fn control_endpoint() -> EndpointInfo {
+        EndpointInfo {
+            addr: EndpointAddress::from_parts(0, Direction::In),
+            ep_type: EndpointType::Control,
+            max_packet_size: 8,
+            interval_ms: 0,
+        }
+    }
+    #[test]
+    fn stuck_halt_times_out_without_blocking_other_futures() {
+        let mut memory = Box::new([0u32; 512]);
+        // SAFETY: the register window is aligned, live and exclusively owned here.
+        let regs = unsafe { Otg::from_ptr(memory.as_mut_ptr().cast()) };
+        let storage = HostStateStorage::<1>::new(CriticalSectionRawMutex::new());
+        let alloc = OtgHostAllocator {
+            regs,
+            state: storage.as_host_state(),
+        };
+        let channel = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(1, &control_endpoint(), None)
+            .unwrap();
+        regs.hcchar(0).modify(|w| w.set_chena(true));
+        let mut progressed = false;
+        let (result, ()) = futures_executor::block_on(embassy_futures::join::join(channel.halt_channel(), async {
+            embassy_time::Timer::after_micros(1).await;
+            progressed = true;
+        }));
+        assert_eq!(result, Err(PipeError::BadResponse));
+        assert!(progressed);
+    }
+    #[test]
+    fn pending_old_halt_does_not_publish_new_rx_buffer() {
+        let mut memory = Box::new([0u32; 512]);
+        let regs = unsafe { Otg::from_ptr(memory.as_mut_ptr().cast()) };
+        let storage = HostStateStorage::<1>::new(CriticalSectionRawMutex::new());
+        let alloc = OtgHostAllocator {
+            regs,
+            state: storage.as_host_state(),
+        };
+        let mut channel = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(1, &control_endpoint(), None)
+            .unwrap();
+        regs.hcchar(0).modify(|w| w.set_chena(true));
+        let mut packet = [0; 8];
+        let mut transfer = Box::pin(channel.do_in_transfer(EndpointType::Control, &mut packet, 0));
+        assert!(poll_once(transfer.as_mut()).is_pending());
+        // No packet from the previous transaction may target this caller's buffer.
+        assert!(unsafe { *storage.channels[0].rx_buffer.get() }.is_null());
+        drop(transfer);
+        assert!(unsafe { *storage.channels[0].rx_buffer.get() }.is_null());
+    }
+    #[test]
+    fn preamble_channels_serialize_and_cancel_with_a_fresh_frame_gap() {
+        let mut memory = Box::new([0u32; 512]);
+        let regs = unsafe { Otg::from_ptr(memory.as_mut_ptr().cast()) };
+        let storage = HostStateStorage::<2>::new(CriticalSectionRawMutex::new());
+        let alloc = OtgHostAllocator {
+            regs,
+            state: storage.as_host_state(),
+        };
+        let route = Some(SplitInfo::new(1, 1, SplitSpeed::Low));
+        let mut first = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(2, &control_endpoint(), route)
+            .unwrap();
+        let mut second = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(3, &control_endpoint(), route)
+            .unwrap();
+        // Empty OUT packets avoid touching the simulated FIFO window.
+        let mut a = Box::pin(first.do_out_transfer(EndpointType::Control, &[], 0));
+        let mut b = Box::pin(second.do_out_transfer(EndpointType::Control, &[], 0));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(poll_once(b.as_mut()).is_pending());
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(regs.hcchar(0).read().chena());
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(!regs.hcchar(1).read().chena());
+        drop(a);
+        assert!(regs.hcchar(0).read().chdis()); // cancellation requests a halt
+        regs.hcchar(0).modify(|w| w.set_chena(false)); // hardware finishes halting
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(!regs.hcchar(1).read().chena()); // next channel waits a fresh frame
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(regs.hcchar(1).read().chena());
+        drop(b);
+        assert!(regs.hcchar(1).read().chdis());
+    }
+    #[test]
+    fn preamble_nak_releases_lock_before_yielding_to_other_channels() {
+        let mut memory = Box::new([0u32; 512]);
+        let regs = unsafe { Otg::from_ptr(memory.as_mut_ptr().cast()) };
+        let storage = HostStateStorage::<2>::new(CriticalSectionRawMutex::new());
+        let alloc = OtgHostAllocator {
+            regs,
+            state: storage.as_host_state(),
+        };
+        let route = Some(SplitInfo::new(1, 1, SplitSpeed::Low));
+        let mut first = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(2, &control_endpoint(), route)
+            .unwrap();
+        let mut second = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(3, &control_endpoint(), route)
+            .unwrap();
+        let mut a = Box::pin(first.do_out_transfer(EndpointType::Control, &[], 0));
+        let mut b = Box::pin(second.do_out_transfer(EndpointType::Control, &[], 0));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(poll_once(b.as_mut()).is_pending());
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(regs.hcchar(0).read().chena());
+        regs.hcchar(0).modify(|w| w.set_chena(false));
+        storage.channels[0].result.store(EV_NAK, Ordering::Release);
+        assert!(poll_once(a.as_mut()).is_pending());
+        // Unlike a yield while holding the mutex, the waiting channel now
+        // gets the next turn, so an idle keyboard cannot starve enumeration.
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(poll_once(a.as_mut()).is_pending());
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(regs.hcchar(1).read().chena());
+        assert!(!regs.hcchar(0).read().chena());
+    }
+
+    #[test]
+    fn serialized_bus_keeps_full_speed_hub_tokens_out_of_low_speed_transfers() {
+        let mut memory = Box::new([0u32; 512]);
+        let regs = unsafe { Otg::from_ptr(memory.as_mut_ptr().cast()) };
+        let storage = HostStateStorage::<2>::new(CriticalSectionRawMutex::new());
+        storage.fields.serialize_transactions.store(true, Ordering::Release);
+        let alloc = OtgHostAllocator {
+            regs,
+            state: storage.as_host_state(),
+        };
+        let mut fs = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(1, &control_endpoint(), None)
+            .unwrap();
+        let mut ls = alloc
+            .alloc_pipe::<pipe::Control, pipe::InOut>(
+                2,
+                &control_endpoint(),
+                Some(SplitInfo::new(1, 1, SplitSpeed::Low)),
+            )
+            .unwrap();
+        let mut a = Box::pin(fs.do_out_transfer(EndpointType::Control, &[], 0));
+        let mut b = Box::pin(ls.do_out_transfer(EndpointType::Control, &[], 0));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(poll_once(b.as_mut()).is_pending());
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(regs.hcchar(0).read().chena());
+        assert!(!regs.hcchar(1).read().chena());
+        regs.hcchar(0).modify(|w| w.set_chena(false));
+        storage.channels[0].result.store(EV_XFRC, Ordering::Release);
+        assert!(poll_once(a.as_mut()).is_pending());
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(poll_once(a.as_mut()).is_ready());
+        thread::sleep(StdDuration::from_millis(2));
+        assert!(poll_once(b.as_mut()).is_pending());
+        assert!(regs.hcchar(1).read().chena());
+    }
+}
