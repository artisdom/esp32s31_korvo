+#[path = "../../../src/ble/btdm2/classic_crypto.rs"]
+mod crypto;
+#[path = "../../../src/ble/btdm2/classic_pool.rs"]
+mod pool;
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn hex(s: &str) -> Vec<u8> {
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+    #[test]
+    fn scalar_one_matches_published_generators_in_controller_byte_order() {
+        let mut pub192 = [0; 48];
+        let mut priv192 = [0; 24];
+        let mut calls = 0;
+        assert!(crypto::generate192(&mut pub192, &mut priv192, || {
+            calls += 1;
+            if calls % 6 == 0 { 0x01000000 } else { 0 }
+        }));
+        let mut x = hex("188da80eb03090f67cbf20eb43a18800f4ff0afd82ff1012");
+        x.reverse();
+        let mut y = hex("07192b95ffc8da78631011ed6b24cdd573f977a11e794811");
+        y.reverse();
+        assert_eq!(&pub192[..24], x);
+        assert_eq!(&pub192[24..], y);
+        assert_eq!(priv192[0], 1);
+        assert!(priv192[1..].iter().all(|&b| b == 0));
+        let mut pub256 = [0; 64];
+        let mut priv256 = [0; 32];
+        calls = 0;
+        assert!(crypto::generate256(&mut pub256, &mut priv256, || {
+            calls += 1;
+            if calls % 8 == 0 { 0x01000000 } else { 0 }
+        }));
+        let mut x = hex("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296");
+        x.reverse();
+        let mut y = hex("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
+        y.reverse();
+        assert_eq!(&pub256[..32], x);
+        assert_eq!(&pub256[32..], y);
+        assert_eq!(priv256[0], 1);
+        assert!(priv256[1..].iter().all(|&b| b == 0));
+    }
+    #[test]
+    fn invalid_entropy_fails_bounded_without_exporting_a_key() {
+        let mut public = [0xa5; 48];
+        let mut private = [0xa5; 24];
+        let mut calls = 0;
+        assert!(!crypto::generate192(&mut public, &mut private, || {
+            calls += 1;
+            0
+        }));
+        assert_eq!(calls, 32 * 6);
+        assert_eq!(public, [0xa5; 48]);
+        assert_eq!(private, [0xa5; 24]);
+        let mut public = [0xa5; 64];
+        let mut private = [0xa5; 32];
+        calls = 0;
+        assert!(!crypto::generate256(&mut public, &mut private, || {
+            calls += 1;
+            u32::MAX
+        }));
+        assert_eq!(calls, 32 * 8);
+        assert_eq!(public, [0xa5; 64]);
+        assert_eq!(private, [0xa5; 32]);
+    }
+    #[test]
+    fn pool_stays_inside_reserved_memory_and_coalesces_after_repeated_packets() {
+        #[repr(align(8))]
+        struct Memory([u8; 4096]);
+        let mut mem = Memory([0; 4096]);
+        let start = mem.0.as_mut_ptr();
+        let end = unsafe { start.add(4096) };
+        let handle = unsafe { pool::pool_create(start.cast(), 4096, 4096) };
+        assert!(!handle.is_null());
+        for _ in 0..256 {
+            let mut blocks = Vec::new();
+            for size in [17, 35, 221, 61, 9, 400, 3, 127] {
+                let p = unsafe { pool::pool_malloc(handle, size) }.cast::<u8>();
+                assert!(p > start && unsafe { p.add(size) } <= end);
+                assert_eq!(p as usize % 8, 0);
+                unsafe { core::ptr::write_bytes(p, size as u8, size) };
+                blocks.push((p, size));
+            }
+            for (p, size) in blocks.into_iter().rev() {
+                assert!(
+                    unsafe { core::slice::from_raw_parts(p, size) }
+                        .iter()
+                        .all(|&b| b == size as u8)
+                );
+                unsafe { pool::pool_free(handle, p.cast()) };
+            }
+        }
+        assert!(unsafe { pool::pool_malloc(handle, usize::MAX) }.is_null());
+        assert!(unsafe { pool::pool_malloc(handle, 8192) }.is_null());
+        let p = unsafe { pool::pool_malloc(handle, 4000) };
+        assert!(!p.is_null());
+        unsafe { pool::pool_free(handle, p) };
+    }
+}
