index 000000000..2a4d0ff94
--- /dev/null
+++ b/esp-radio/src/ble/btdm2/classic_crypto.rs
@@ -0,0 +1,64 @@
+//! Legacy controller initialization keys only; no pairing/ECDH host support.
+// Output matches IDF's per-coordinate little-endian BR/EDR ABI.
+pub(super) fn generate192(
+    public: &mut [u8; 48],
+    private: &mut [u8; 24],
+    mut random: impl FnMut() -> u32,
+) -> bool {
+    use p192::elliptic_curve::sec1::ToEncodedPoint;
+    let mut bytes = zeroize::Zeroizing::new([0u8; 24]);
+    for _ in 0..32 {
+        for chunk in bytes.chunks_exact_mut(4) {
+            chunk.copy_from_slice(&random().to_le_bytes());
+        }
+        let Ok(secret) = p192::elliptic_curve::SecretKey::<p192::NistP192>::from_slice(&*bytes)
+        else {
+            continue;
+        };
+        let encoded = secret.public_key().to_encoded_point(false);
+        let Some(x) = encoded.x() else {
+            return false;
+        };
+        let Some(y) = encoded.y() else {
+            return false;
+        };
+        for i in 0..24 {
+            public[i] = x[23 - i];
+            public[24 + i] = y[23 - i];
+            private[i] = bytes[23 - i];
+        }
+        return true;
+    }
+    false
+}
+
+pub(super) fn generate256(
+    public: &mut [u8; 64],
+    private: &mut [u8; 32],
+    mut random: impl FnMut() -> u32,
+) -> bool {
+    use p256::elliptic_curve::sec1::ToEncodedPoint;
+    let mut bytes = zeroize::Zeroizing::new([0u8; 32]);
+    for _ in 0..32 {
+        for chunk in bytes.chunks_exact_mut(4) {
+            chunk.copy_from_slice(&random().to_le_bytes());
+        }
+        let Ok(secret) = p256::SecretKey::from_slice(&*bytes) else {
+            continue;
+        };
+        let encoded = secret.public_key().to_encoded_point(false);
+        let Some(x) = encoded.x() else {
+            return false;
+        };
+        let Some(y) = encoded.y() else {
+            return false;
+        };
+        for i in 0..32 {
+            public[i] = x[31 - i];
+            public[32 + i] = y[31 - i];
+            private[i] = bytes[31 - i];
+        }
+        return true;
+    }
+    false
+}
diff --git a/esp-radio/src/ble/btdm2/classic_pool.rs b/esp-radio/src/ble/btdm2/classic_pool.rs
new file mode 100644
index 000000000..ace997491
--- /dev/null
+++ b/esp-radio/src/ble/btdm2/classic_pool.rs
@@ -0,0 +1,55 @@
+//! A coalescing heap limited to the controller's reserved SRAM pool.
+use core::ffi::c_void;
+type Pool = *mut c_void;
+// Controller ownership checks require allocations inside its reserved pool.
+// Store each exact Layout in an aligned prefix so frees can coalesce/reuse it.
+static CLASSIC_POOL: critical_section::Mutex<core::cell::RefCell<linked_list_allocator::Heap>> =
+    critical_section::Mutex::new(core::cell::RefCell::new(
+        linked_list_allocator::Heap::empty(),
+    ));
+pub(super) unsafe extern "C" fn pool_create(mem: *mut c_void, bytes: usize, _: usize) -> Pool {
+    if mem.is_null() || bytes < 64 {
+        return core::ptr::null_mut();
+    }
+    critical_section::with(|cs| unsafe {
+        CLASSIC_POOL.borrow(cs).borrow_mut().init(mem.cast(), bytes);
+    });
+    mem
+}
+pub(super) unsafe extern "C" fn pool_malloc(_: Pool, size: usize) -> *mut c_void {
+    let Some(total) = size.checked_add(8) else {
+        return core::ptr::null_mut();
+    };
+    let Ok(layout) = core::alloc::Layout::from_size_align(total, 8) else {
+        return core::ptr::null_mut();
+    };
+    critical_section::with(|cs| {
+        match CLASSIC_POOL
+            .borrow(cs)
+            .borrow_mut()
+            .allocate_first_fit(layout)
+        {
+            Ok(block) => unsafe {
+                block.as_ptr().cast::<usize>().write(total);
+                block.as_ptr().add(8).cast()
+            },
+            Err(_) => core::ptr::null_mut(),
+        }
+    })
+}
+pub(super) unsafe extern "C" fn pool_free(_: Pool, ptr: *mut c_void) {
+    if ptr.is_null() {
+        return;
+    }
+    let block = unsafe { ptr.cast::<u8>().sub(8) };
+    let total = unsafe { block.cast::<usize>().read() };
+    let Ok(layout) = core::alloc::Layout::from_size_align(total, 8) else {
+        return;
+    };
+    critical_section::with(|cs| unsafe {
+        CLASSIC_POOL
+            .borrow(cs)
+            .borrow_mut()
+            .deallocate(core::ptr::NonNull::new_unchecked(block), layout);
+    });
+}
