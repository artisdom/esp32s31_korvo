+/// On cancellation, halt the transaction and revoke any ISR buffer borrow.
+struct TransferGuard<'d, M: RawMutex + Copy> {
+    regs: Otg,
+    state: HostState<'d, M>,
+    index: usize,
+}
+impl<M: RawMutex + Copy> Drop for TransferGuard<'_, M> {
+    fn drop(&mut self) {
+        self.state.mutex.lock(|| {
+            let ch = &self.state.channels[self.index];
+            // Request a halt without unbounded spinning inside a critical section.
+            if self.regs.hcchar(self.index).read().chena() {
+                self.regs.hcchar(self.index).modify(|w| {
+                    w.set_chdis(true);
+                    w.set_chena(true);
+                });
+            }
+            unsafe {
+                *ch.rx_buffer.get() = core::ptr::null_mut();
+                *ch.rx_count.get() = 0;
+                *ch.rx_capacity.get() = 0;
+            }
+        });
+    }
+}
